# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for Agri-Next Admin Analytics Dashboard.
# Configure this in Settings -> Secrets before sharing or deploying.
ADMIN_PASSCODE=

# GIFT_TOTAL: Number of booth sticker gifts for the "Săn Sticker" game (default 30).
# Can also be changed live from the Admin portal → "Phát quà Sticker".
GIFT_TOTAL=30
